{
  "name": "@bnbu/backend-contract-checks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "check": "node ./check-contract.mjs",
    "lint:openapi": "redocly lint ../../docs/backend-contracts/openapi.yaml --format=stylish --max-problems=1000",
    "contract:check": "npm run check && npm run lint:openapi"
  },
  "devDependencies": {
    "@redocly/cli": "2.43.2",
    "yaml": "2.9.0"
  }
}
