# Copy to .env for local-only synthetic development. Replace every CHANGE_ME value.
APP_ENV=local
APP_VERSION=local-dev
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgresql://bnbu_app:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5433/bnbu_sports?schema=public
MIGRATION_DATABASE_URL=postgresql://bnbu_migrator:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5433/bnbu_sports?schema=public
# Docker-local bootstrap credentials are infrastructure-only. The runtime and migrator
# identities below must remain distinct lowercase PostgreSQL identifiers.
POSTGRES_DB=bnbu_sports
POSTGRES_BOOTSTRAP_USER=bnbu_bootstrap
POSTGRES_BOOTSTRAP_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_APP_USER=bnbu_app
POSTGRES_APP_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_MIGRATOR_USER=bnbu_migrator
POSTGRES_MIGRATOR_PASSWORD=CHANGE_ME_LOCAL_ONLY
TOKEN_ISSUER=bnbu-sports-local
TOKEN_AUDIENCE=bnbu-sports-local-clients
TOKEN_SIGNING_KEY=CHANGE_ME_LOCAL_TEST_PRIVATE_KEY
TOKEN_VERIFYING_KEY=CHANGE_ME_LOCAL_TEST_PUBLIC_KEY
ACCESS_TOKEN_TTL=CHANGE_ME_EXPLICIT_DURATION
REFRESH_TOKEN_ABSOLUTE_TTL=CHANGE_ME_EXPLICIT_DURATION
REFRESH_TOKEN_IDLE_TTL=CHANGE_ME_EXPLICIT_DURATION
IDEMPOTENCY_RETENTION=CHANGE_ME_EXPLICIT_DURATION
IDEMPOTENCY_LEASE=CHANGE_ME_EXPLICIT_DURATION
IDEMPOTENCY_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_LOCAL_ONLY_KEY
SECURITY_HASH_KEY=CHANGE_ME_LOCAL_ONLY
AUTH_RATE_LIMIT_WINDOW_SECONDS=CHANGE_ME_EXPLICIT_DURATION
AUTH_RATE_LIMIT_MAX_ATTEMPTS=CHANGE_ME_EXPLICIT_INTEGER
CORS_ALLOWLIST=http://127.0.0.1:3001
TRUST_PROXY=false
SYSTEM_MODE_SOURCE=database
REQUEST_BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=10000
COURSE_INVITE_TTL_SECONDS=CHANGE_ME_EXPLICIT_DURATION
JOIN_CAPABILITY_TTL_SECONDS=CHANGE_ME_EXPLICIT_DURATION
QR_JOIN_TOKEN_HASH_KEY=CHANGE_ME_BASE64_32_BYTE_LOCAL_ONLY_KEY
QR_JOIN_SECRET_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_LOCAL_ONLY_KEY
QR_JOIN_SECRET_REPLAY_SECONDS=CHANGE_ME_EXPLICIT_DURATION
QR_JOIN_PUBLIC_RATE_LIMIT_WINDOW_SECONDS=CHANGE_ME_EXPLICIT_DURATION
QR_JOIN_PUBLIC_RATE_LIMIT_MAX_REQUESTS=CHANGE_ME_EXPLICIT_INTEGER

# Local email delivery is isolated in the Mailpit service below. Do not place
# production mailbox credentials in this file or commit them to the repository.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM_ADDRESS=no-reply@local.bnbu.invalid
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Required before push-device registration is enabled. Keep this key separate from all other keys.
PUSH_TOKEN_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_LOCAL_ONLY_KEY
PUSH_TOKEN_ENCRYPTION_KEY_VERSION=1
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=local
OBJECT_STORAGE_BUCKET=bnbu-sports-local-private
OBJECT_STORAGE_ACCESS_KEY=CHANGE_ME_LOCAL_ONLY
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME_LOCAL_ONLY
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_REQUIRED=false

# Local-validation-only MediaEvidence private storage. Production values require separate approval.
MEDIA_STORAGE_REQUIRED=true
MEDIA_STORAGE_ENDPOINT=http://127.0.0.1:9000
MEDIA_STORAGE_REGION=local
MEDIA_STORAGE_BUCKET=bnbu-sports-local-media-private
MEDIA_STORAGE_ACCESS_KEY=CHANGE_ME_LOCAL_ONLY
MEDIA_STORAGE_SECRET_KEY=CHANGE_ME_LOCAL_ONLY
MEDIA_STORAGE_FORCE_PATH_STYLE=true
MEDIA_UPLOAD_URL_TTL_SECONDS=300
MEDIA_ACCESS_URL_TTL_SECONDS=300
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_IMAGE_PIXELS=40000000
MEDIA_MAX_VIDEO_TRANSPORT_BYTES=536870912
MEDIA_SCANNER_MODE=TEST_SIGNATURE
MEDIA_WORKER_ENABLED=true
MEDIA_WORKER_POLL_MS=500
MINIO_ROOT_USER=CHANGE_ME_LOCAL_ONLY
MINIO_ROOT_PASSWORD=CHANGE_ME_LOCAL_ONLY
MINIO_BUCKET=bnbu-sports-local-private
LOCAL_SEED_TEACHER_PASSWORD=CHANGE_ME_LOCAL_ONLY
LOCAL_SEED_ADMIN_PASSWORD=CHANGE_ME_LOCAL_ONLY
