  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  principal    User?        @relation("IdempotencyPrincipal", fields: [principalId, organizationId], references: [id, organizationId], onDelete: Restrict)
  authSession  AuthSession? @relation(fields: [authSessionId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([scopeHash, keyHash], map: "idempotency_records_scope_hash_key_hash_key")
  @@index([status, leaseExpiresAt], map: "idempotency_records_status_lease_expires_at_idx")
  @@index([expiresAt], map: "idempotency_records_expires_at_idx")
  @@map("idempotency_records")
}

model ScoreRule {
  id                    String    @id @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  classSectionId        String    @map("class_section_id") @db.Uuid
  semesterId            String    @map("semester_id") @db.Uuid
  ruleCode              String    @map("rule_code") @db.VarChar(64)
  ruleVersion           Int       @map("rule_version")
  displayName           String    @map("display_name") @db.VarChar(200)
  totalRequiredSeconds  BigInt    @default(72000) @map("total_required_seconds")
  calculationDefinition Json      @map("calculation_definition") @db.JsonB
  roundingMode          String    @default("HALF_UP") @map("rounding_mode") @db.VarChar(16)
  roundingScale         Int       @default(2) @map("rounding_scale")
  status                String    @db.VarChar(32)
  createdBy             String    @map("created_by") @db.Uuid
  submittedAt           DateTime? @map("submitted_at") @db.Timestamptz(6)
  activatedAt           DateTime? @map("activated_at") @db.Timestamptz(6)
  supersededAt          DateTime? @map("superseded_at") @db.Timestamptz(6)
  createdAt             DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @map("updated_at") @db.Timestamptz(6)
  version               Int       @default(1)

  organization          Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  classSection          ClassSection                @relation(fields: [classSectionId, semesterId, organizationId], references: [id, semesterId, organizationId], onDelete: Restrict, map: "score_rules_class_section_scope_fkey")
  semester              Semester                    @relation(fields: [semesterId, organizationId], references: [id, organizationId], onDelete: Restrict)
  creator               User                        @relation("ScoreRuleCreatedBy", fields: [createdBy, organizationId], references: [id, organizationId], onDelete: Restrict)
  approvalEvents        ScoreRuleApprovalEvent[]
  scoreRevisions        StudentScoreRevision[]
  scoreContributions    ScoreContribution[]
  recalculationAttempts ScoreRecalculationAttempt[]

  @@unique([id, organizationId], map: "score_rules_id_organization_id_key")
  @@unique([classSectionId, ruleVersion], map: "score_rules_section_version_key")
  @@index([organizationId, classSectionId, status, ruleVersion], map: "score_rules_section_status_version_idx")
  @@map("score_rules")
}

