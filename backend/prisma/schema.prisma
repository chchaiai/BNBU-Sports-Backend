model StudentScore {
  id                       String   @id @db.Uuid
  organizationId           String   @map("organization_id") @db.Uuid
  semesterId               String   @map("semester_id") @db.Uuid
  classSectionId           String   @map("class_section_id") @db.Uuid
  studentId                String   @map("student_id") @db.Uuid
  enrollmentId             String   @unique(map: "student_scores_enrollment_id_key") @map("enrollment_id") @db.Uuid
  currentWorkingRevisionId String?  @map("current_working_revision_id") @db.Uuid
  publishedRevisionId      String?  @map("published_revision_id") @db.Uuid
  version                  Int      @default(1)
  createdAt                DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime @map("updated_at") @db.Timestamptz(6)

  organization           Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  semester               Semester                    @relation(fields: [semesterId, organizationId], references: [id, organizationId], onDelete: Restrict)
  classSection           ClassSection                @relation(fields: [classSectionId, semesterId, organizationId], references: [id, semesterId, organizationId], onDelete: Restrict, map: "student_scores_class_section_scope_fkey")
  student                StudentProfile              @relation(fields: [studentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  enrollment             Enrollment                  @relation(fields: [enrollmentId, semesterId, classSectionId, studentId, organizationId], references: [id, semesterId, classSectionId, studentId, organizationId], onDelete: Restrict, map: "student_scores_enrollment_scope_fkey")
  revisions              StudentScoreRevision[]      @relation("StudentScoreRevisions")
  currentWorkingRevision StudentScoreRevision?       @relation("CurrentWorkingScoreRevision", fields: [currentWorkingRevisionId, id, organizationId], references: [id, studentScoreId, organizationId], onDelete: Restrict)
  publishedRevision      StudentScoreRevision?       @relation("PublishedScoreRevision", fields: [publishedRevisionId, id, organizationId], references: [id, studentScoreId, organizationId], onDelete: Restrict)
  adjustments            ScoreAdjustment[]
  publicationEvents      ScorePublicationEvent[]
  recalculationAttempts  ScoreRecalculationAttempt[]

  @@unique([id, organizationId], map: "student_scores_id_organization_id_key")
  @@unique([enrollmentId, semesterId, classSectionId, studentId, organizationId], map: "student_scores_enrollment_scope_key")
  @@index([organizationId, classSectionId, updatedAt, id], map: "student_scores_section_updated_idx")
  @@index([organizationId, studentId, updatedAt, id], map: "student_scores_student_updated_idx")
  @@map("student_scores")
}

model StudentScoreRevision {
  id                        String   @id @db.Uuid
  organizationId            String   @map("organization_id") @db.Uuid
  studentScoreId            String   @map("student_score_id") @db.Uuid
  scoreRuleId               String   @map("score_rule_id") @db.Uuid
  calculationRevision       Int      @map("calculation_revision")
  totalValidCreditedSeconds BigInt   @map("total_valid_credited_seconds")
  scoringSeconds            BigInt   @map("scoring_seconds")
  excessSeconds             BigInt   @map("excess_seconds")
  qualificationStatus       String   @map("qualification_status") @db.VarChar(32)
  calculatedScore           Decimal  @map("calculated_score") @db.Decimal(5, 2)
  adjustedScore             Decimal  @map("adjusted_score") @db.Decimal(5, 2)
  finalScore                Decimal  @map("final_score") @db.Decimal(5, 2)
  sourceFingerprint         String   @map("source_fingerprint") @db.Char(64)
  status                    String   @db.VarChar(16)
  calculatedAt              DateTime @map("calculated_at") @db.Timestamptz(6)
  createdAt                 DateTime @map("created_at") @db.Timestamptz(6)

  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  studentScore      StudentScore            @relation("StudentScoreRevisions", fields: [studentScoreId, organizationId], references: [id, organizationId], onDelete: Restrict)
  scoreRule         ScoreRule               @relation(fields: [scoreRuleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  contributions     ScoreContribution[]
  workingFor        StudentScore[]          @relation("CurrentWorkingScoreRevision")
  publishedFor      StudentScore[]          @relation("PublishedScoreRevision")
  publicationEvents ScorePublicationEvent[]

  @@unique([id, studentScoreId, organizationId], map: "student_score_revisions_id_score_organization_key")
  @@unique([id, organizationId], map: "student_score_revisions_id_organization_id_key")
  @@unique([studentScoreId, calculationRevision], map: "student_score_revisions_score_revision_key")
  @@unique([studentScoreId, scoreRuleId, sourceFingerprint], map: "student_score_revisions_source_key")
  @@index([organizationId, studentScoreId, calculatedAt, id], map: "student_score_revisions_score_calculated_idx")
  @@map("student_score_revisions")
}

model ScoreContribution {
  id                     String   @id @db.Uuid
  organizationId         String   @map("organization_id") @db.Uuid
  studentScoreRevisionId String   @map("student_score_revision_id") @db.Uuid
  recordId               String   @map("record_id") @db.Uuid
