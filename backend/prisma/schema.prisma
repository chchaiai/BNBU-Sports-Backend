generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id               String   @id @db.Uuid
  organizationCode String   @unique(map: "organizations_organization_code_key") @map("organization_code") @db.VarChar(32)
  legalName        String   @map("legal_name") @db.VarChar(300)
  displayName      String   @map("display_name") @db.VarChar(200)
  timezone         String   @db.VarChar(64)
  defaultLocale    String   @map("default_locale") @db.VarChar(35)
  status           String   @db.VarChar(32)
  version          Int      @default(1)
  createdAt        DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @map("updated_at") @db.Timestamptz(6)

  systemPolicy                   SystemPolicy?
  users                          User[]
  studentProfiles                StudentProfile[]
  teacherProfiles                TeacherProfile[]
  adminProfiles                  AdminProfile[]
  authSessions                   AuthSession[]
  refreshTokens                  RefreshToken[]
  semesters                      Semester[]
  courses                        Course[]
  classSections                  ClassSection[]
  excludedDates                  ClassSectionExcludedDate[]
  courseInvites                  CourseInvite[]
  joinCapabilities               JoinCapability[]
  enrollments                    Enrollment[]
  enrollmentEvents               EnrollmentStatusEvent[]
  officialRosterImports          OfficialRosterImport[]
  officialRosterEntries          OfficialRosterEntry[]
  rosterAlignmentRuns            RosterAlignmentRun[]
  rosterAlignmentPlatformEntries RosterAlignmentPlatformEntry[]
  rosterAlignmentResults         RosterAlignmentResult[]
  rosterResolutionEvents         RosterResolutionEvent[]
  exerciseSessions               ExerciseSession[]
  exerciseSessionSegments        ExerciseSessionSegment[]
  exerciseSessionEvents          ExerciseSessionEvent[]
  mediaEvidence                  MediaEvidence[]
  exerciseRecords                ExerciseRecord[]
  exerciseRecordMedia            ExerciseRecordMedia[]
  exerciseRecordEvents           ExerciseRecordEvent[]
  exerciseRecordDailySlots       ExerciseRecordDailySlot[]
  reviewRecords                  ReviewRecord[]
  scoreRules                     ScoreRule[]
  scoreRuleApprovalEvents        ScoreRuleApprovalEvent[]
  studentScores                  StudentScore[]
  studentScoreRevisions          StudentScoreRevision[]
  scoreContributions             ScoreContribution[]
  scoreAdjustments               ScoreAdjustment[]
  scoreAdjustmentApprovalEvents  ScoreAdjustmentApprovalEvent[]
  scorePublicationEvents         ScorePublicationEvent[]
  scoreRecalculationAttempts     ScoreRecalculationAttempt[]
  mediaUploadSessions            MediaUploadSession[]
  mediaStatusEvents              MediaStatusEvent[]
  mediaProcessingAttempts        MediaProcessingAttempt[]
  idempotencyRecords             IdempotencyRecord[]
  auditLogs                      AuditLog[]
  outboxEvents                   OutboxEvent[]

  @@map("organizations")
}

model SystemPolicy {
  organizationId String   @id @map("organization_id") @db.Uuid
  systemMode     String   @map("system_mode") @db.VarChar(32)
  version        Int      @default(1)
  changedBy      String   @map("changed_by") @db.Uuid
  changeReason   String   @map("change_reason") @db.VarChar(500)
  updatedAt      DateTime @map("updated_at") @db.Timestamptz(6)

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  changedByUser User         @relation("SystemPolicyChangedBy", fields: [changedBy, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([changedBy], map: "system_policies_changed_by_idx")
  @@map("system_policies")
}

model User {
  id                     String    @id @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  role                   String    @db.VarChar(32)
  status                 String    @db.VarChar(32)
  primaryEmail           String?   @map("primary_email") @db.VarChar(254)
  primaryEmailNormalized String?   @map("primary_email_normalized") @db.VarChar(254)
  emailVerifiedAt        DateTime? @map("email_verified_at") @db.Timestamptz(6)
  primaryPhone           String?   @map("primary_phone") @db.VarChar(32)
  primaryPhoneNormalized String?   @map("primary_phone_normalized") @db.VarChar(32)
  phoneVerifiedAt        DateTime? @map("phone_verified_at") @db.Timestamptz(6)
  passwordHash           String?   @map("password_hash") @db.VarChar(255)
  tokenVersion           Int       @default(0) @map("token_version")
  lastAuthenticatedAt    DateTime? @map("last_authenticated_at") @db.Timestamptz(6)
  version                Int       @default(1)
  createdAt              DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization              Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  studentProfile            StudentProfile?
  teacherProfile            TeacherProfile?
  adminProfile              AdminProfile?
  authSessions              AuthSession[]
  idempotencyRecords        IdempotencyRecord[]            @relation("IdempotencyPrincipal")
  auditLogs                 AuditLog[]                     @relation("AuditActor")
  systemPolicyChanges       SystemPolicy[]                 @relation("SystemPolicyChangedBy")
  createdSemesters          Semester[]                     @relation("SemesterCreatedBy")
  createdCourses            Course[]                       @relation("CourseCreatedBy")
  updatedCourses            Course[]                       @relation("CourseUpdatedBy")
  deletedCourses            Course[]                       @relation("CourseDeletedBy")
  createdClassSections      ClassSection[]                 @relation("ClassSectionCreatedBy")
  updatedClassSections      ClassSection[]                 @relation("ClassSectionUpdatedBy")
  closedClassSections       ClassSection[]                 @relation("ClassSectionClosedBy")
  createdExcludedDates      ClassSectionExcludedDate[]     @relation("ClassSectionExcludedDateCreatedBy")
  createdCourseInvites      CourseInvite[]                 @relation("CourseInviteCreatedBy")
  revokedCourseInvites      CourseInvite[]                 @relation("CourseInviteRevokedBy")
  consumedCapabilities      JoinCapability[]               @relation("JoinCapabilityConsumedBy")
  createdEnrollments        Enrollment[]                   @relation("EnrollmentCreatedBy")
  updatedEnrollments        Enrollment[]                   @relation("EnrollmentUpdatedBy")
  enrollmentEvents          EnrollmentStatusEvent[]        @relation("EnrollmentStatusEventActor")
  importedOfficialRosters   OfficialRosterImport[]         @relation("OfficialRosterImportImportedBy")
  startedRosterAlignments   RosterAlignmentRun[]           @relation("RosterAlignmentRunStartedBy")
  resolvedRosterResults     RosterAlignmentResult[]        @relation("RosterAlignmentResultResolvedBy")
  rosterResolutionEvents    RosterResolutionEvent[]        @relation("RosterResolutionEventActor")
  exerciseSessionEvents     ExerciseSessionEvent[]         @relation("ExerciseSessionEventActor")
  initiatedMediaEvidence    MediaEvidence[]                @relation("MediaEvidenceInitiatedBy")
  exerciseRecordEvents      ExerciseRecordEvent[]          @relation("ExerciseRecordEventActor")
  createdScoreRules         ScoreRule[]                    @relation("ScoreRuleCreatedBy")
  scoreRuleApprovals        ScoreRuleApprovalEvent[]       @relation("ScoreRuleApprovalActor")
  requestedScoreAdjustments ScoreAdjustment[]              @relation("ScoreAdjustmentRequestedBy")
  scoreAdjustmentApprovals  ScoreAdjustmentApprovalEvent[] @relation("ScoreAdjustmentApprovalActor")
  scorePublicationEvents    ScorePublicationEvent[]        @relation("ScorePublicationActor")

  @@unique([id, organizationId], map: "users_id_organization_id_key")
  @@unique([organizationId, primaryEmailNormalized], map: "users_organization_email_normalized_key")
  @@unique([organizationId, primaryPhoneNormalized], map: "users_organization_phone_normalized_key")
  @@index([organizationId, role, status], map: "users_organization_role_status_idx")
  @@map("users")
}

model StudentProfile {
  id                      String    @id @db.Uuid
  organizationId          String    @map("organization_id") @db.Uuid
  userId                  String    @unique(map: "student_profiles_user_id_key") @map("user_id") @db.Uuid
  studentNumber           String    @map("student_number") @db.VarChar(32)
  fullName                String    @map("full_name") @db.VarChar(100)
  gender                  String    @db.VarChar(32)
  gradeYear               Int       @map("grade_year")
  collegeName             String?   @map("college_name") @db.VarChar(200)
  majorName               String?   @map("major_name") @db.VarChar(200)
  administrativeClassName String?   @map("administrative_class_name") @db.VarChar(200)
  status                  String    @db.VarChar(32)
  version                 Int       @default(1)
  createdAt               DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @map("updated_at") @db.Timestamptz(6)
  deletedAt               DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization                   Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user                           User                           @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Restrict)
  enrollments                    Enrollment[]
  rosterAlignmentPlatformEntries RosterAlignmentPlatformEntry[]
  exerciseSessions               ExerciseSession[]
  mediaEvidence                  MediaEvidence[]
  exerciseRecords                ExerciseRecord[]
  studentScores                  StudentScore[]
  scoreAdjustments               ScoreAdjustment[]

  @@unique([id, organizationId], map: "student_profiles_id_organization_id_key")
  @@unique([organizationId, studentNumber], map: "student_profiles_organization_student_number_key")
  @@unique([userId, organizationId], map: "student_profiles_user_id_organization_id_key")
  @@index([organizationId, fullName], map: "student_profiles_organization_full_name_idx")
  @@map("student_profiles")
}

model TeacherProfile {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @unique(map: "teacher_profiles_user_id_key") @map("user_id") @db.Uuid
  employeeNumber String    @map("employee_number") @db.VarChar(32)
  fullName       String    @map("full_name") @db.VarChar(100)
  collegeName    String?   @map("college_name") @db.VarChar(200)
  departmentName String?   @map("department_name") @db.VarChar(200)
  title          String?   @db.VarChar(100)
  status         String    @db.VarChar(32)
  version        Int       @default(1)
  createdAt      DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user            User             @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Restrict)
  classSections   ClassSection[]
  exerciseRecords ExerciseRecord[] @relation("ExerciseRecordResponsibleTeacher")
  reviewRecords   ReviewRecord[]   @relation("ReviewRecordTeacher")

  @@unique([id, organizationId], map: "teacher_profiles_id_organization_id_key")
  @@unique([organizationId, employeeNumber], map: "teacher_profiles_organization_employee_number_key")
  @@unique([userId, organizationId], map: "teacher_profiles_user_id_organization_id_key")
  @@map("teacher_profiles")
}

model AdminProfile {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @unique(map: "admin_profiles_user_id_key") @map("user_id") @db.Uuid
  employeeNumber String    @map("employee_number") @db.VarChar(32)
  fullName       String    @map("full_name") @db.VarChar(100)
  departmentName String?   @map("department_name") @db.VarChar(200)
  status         String    @db.VarChar(32)
  version        Int       @default(1)
  createdAt      DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, employeeNumber], map: "admin_profiles_organization_employee_number_key")
  @@unique([userId, organizationId], map: "admin_profiles_user_id_organization_id_key")
  @@map("admin_profiles")
}

model AuthSession {
  id                String    @id @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  deviceIdHash      String?   @map("device_id_hash") @db.Char(64)
  status            String    @db.VarChar(32)
  tokenFamilyId     String    @unique(map: "auth_sessions_token_family_id_key") @map("token_family_id") @db.Uuid
  createdAt         DateTime  @map("created_at") @db.Timestamptz(6)
  lastSeenAt        DateTime  @map("last_seen_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReasonCode  String?   @map("revoke_reason_code") @db.VarChar(64)
  version           Int       @default(1)

  organization            Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user                    User                   @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Restrict)
  refreshTokens           RefreshToken[]
  idempotencyRecords      IdempotencyRecord[]
  joinCapabilities        JoinCapability[]
  startedExerciseSessions ExerciseSession[]      @relation("ExerciseSessionStartedByAuthSession")
  exerciseSessionEvents   ExerciseSessionEvent[] @relation("ExerciseSessionEventAuthSession")
  exerciseRecordEvents    ExerciseRecordEvent[]  @relation("ExerciseRecordEventAuthSession")

  @@unique([id, organizationId], map: "auth_sessions_id_organization_id_key")
  @@index([organizationId, userId, status], map: "auth_sessions_organization_user_status_idx")
  @@index([idleExpiresAt], map: "auth_sessions_idle_expires_at_idx")
  @@map("auth_sessions")
}

model RefreshToken {
  id                String    @id @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  authSessionId     String    @map("auth_session_id") @db.Uuid
  tokenHash         String    @unique(map: "refresh_tokens_token_hash_key") @map("token_hash") @db.Char(64)
  parentTokenId     String?   @unique(map: "refresh_tokens_parent_token_id_key") @map("parent_token_id") @db.Uuid
  replacedByTokenId String?   @unique(map: "refresh_tokens_replaced_by_token_id_key") @map("replaced_by_token_id") @db.Uuid
  issuedAt          DateTime  @map("issued_at") @db.Timestamptz(6)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt        DateTime? @map("consumed_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  reuseDetectedAt   DateTime? @map("reuse_detected_at") @db.Timestamptz(6)

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  authSession     AuthSession    @relation(fields: [authSessionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  parentToken     RefreshToken?  @relation("RefreshTokenParent", fields: [parentTokenId, organizationId], references: [id, organizationId], onDelete: Restrict)
  childTokens     RefreshToken[] @relation("RefreshTokenParent")
  replacedByToken RefreshToken?  @relation("RefreshTokenReplacement", fields: [replacedByTokenId, organizationId], references: [id, organizationId], onDelete: Restrict)
  replacesTokens  RefreshToken[] @relation("RefreshTokenReplacement")

  @@unique([id, organizationId], map: "refresh_tokens_id_organization_id_key")
  @@index([authSessionId, issuedAt], map: "refresh_tokens_session_issued_at_idx")
  @@index([expiresAt], map: "refresh_tokens_expires_at_idx")
  @@map("refresh_tokens")
}

model Semester {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  academicYear   String   @map("academic_year") @db.VarChar(9)
  termCode       String   @map("term_code") @db.VarChar(32)
  displayName    String   @map("display_name") @db.VarChar(100)
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  status         String   @db.VarChar(32)
  createdBy      String?  @map("created_by") @db.Uuid
  version        Int      @default(1)
  createdAt      DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @map("updated_at") @db.Timestamptz(6)

  organization                   Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdByUser                  User?                          @relation("SemesterCreatedBy", fields: [createdBy, organizationId], references: [id, organizationId], onDelete: Restrict)
  classSections                  ClassSection[]
  enrollments                    Enrollment[]
  rosterAlignmentRuns            RosterAlignmentRun[]
  rosterAlignmentPlatformEntries RosterAlignmentPlatformEntry[]
  exerciseSessions               ExerciseSession[]
  exerciseRecords                ExerciseRecord[]
  scoreRules                     ScoreRule[]
  studentScores                  StudentScore[]

  @@unique([id, organizationId], map: "semesters_id_organization_id_key")
  @@unique([organizationId, academicYear, termCode], map: "semesters_organization_academic_year_term_code_key")
  @@index([organizationId, status], map: "semesters_organization_status_idx")
  @@index([createdBy], map: "semesters_created_by_idx")
  @@map("semesters")
}

model Course {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  courseCode     String    @map("course_code") @db.VarChar(32)
  courseName     String    @map("course_name") @db.VarChar(200)
  description    String?   @db.VarChar(2000)
  status         String    @default("ACTIVE") @db.VarChar(16)
  createdBy      String    @map("created_by") @db.Uuid
  updatedBy      String    @map("updated_by") @db.Uuid
  createdAt      DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy      String?   @map("deleted_by") @db.Uuid
  version        Int       @default(1)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdByUser   User             @relation("CourseCreatedBy", fields: [createdBy, organizationId], references: [id, organizationId], onDelete: Restrict)
  updatedByUser   User             @relation("CourseUpdatedBy", fields: [updatedBy, organizationId], references: [id, organizationId], onDelete: Restrict)
  deletedByUser   User?            @relation("CourseDeletedBy", fields: [deletedBy, organizationId], references: [id, organizationId], onDelete: Restrict)
  classSections   ClassSection[]
  exerciseRecords ExerciseRecord[]

  @@unique([id, organizationId], map: "courses_id_organization_id_key")
  @@unique([organizationId, courseCode], map: "courses_organization_course_code_key")
  @@index([organizationId, status, courseCode, id], map: "courses_organization_status_code_id_idx")
  @@index([organizationId, updatedAt, id], map: "courses_organization_updated_at_id_idx")
  @@map("courses")
}

model ClassSection {
  id                   String    @id @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  courseId             String    @map("course_id") @db.Uuid
  semesterId           String    @map("semester_id") @db.Uuid
  teacherId            String    @map("teacher_id") @db.Uuid
  classCode            String    @map("class_code") @db.VarChar(64)
  displayName          String    @map("display_name") @db.VarChar(200)
  status               String    @db.VarChar(16)
  isEnrollmentOpen     Boolean   @default(false) @map("is_enrollment_open")
  checkInWindowMode    String    @default("UNAVAILABLE") @map("check_in_window_mode") @db.VarChar(32)
  checkInStartDate     DateTime? @map("check_in_start_date") @db.Date
  checkInEndDate       DateTime? @map("check_in_end_date") @db.Date
  dailyStartTime       DateTime? @map("daily_start_time") @db.Time(0)
  dailyEndTime         DateTime? @map("daily_end_time") @db.Time(0)
  submissionDeadlineAt DateTime? @map("submission_deadline_at") @db.Timestamptz(6)
  createdBy            String    @map("created_by") @db.Uuid
  updatedBy            String    @map("updated_by") @db.Uuid
  createdAt            DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @map("updated_at") @db.Timestamptz(6)
  version              Int       @default(1)
  closedAt             DateTime? @map("closed_at") @db.Timestamptz(6)
  closedBy             String?   @map("closed_by") @db.Uuid
  closeReason          String?   @map("close_reason") @db.VarChar(1000)

  organization                   Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  course                         Course                         @relation(fields: [courseId, organizationId], references: [id, organizationId], onDelete: Restrict)
  semester                       Semester                       @relation(fields: [semesterId, organizationId], references: [id, organizationId], onDelete: Restrict)
  teacher                        TeacherProfile                 @relation(fields: [teacherId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdByUser                  User                           @relation("ClassSectionCreatedBy", fields: [createdBy, organizationId], references: [id, organizationId], onDelete: Restrict)
  updatedByUser                  User                           @relation("ClassSectionUpdatedBy", fields: [updatedBy, organizationId], references: [id, organizationId], onDelete: Restrict)
  closedByUser                   User?                          @relation("ClassSectionClosedBy", fields: [closedBy, organizationId], references: [id, organizationId], onDelete: Restrict)
  excludedDates                  ClassSectionExcludedDate[]
  courseInvites                  CourseInvite[]
  capabilities                   JoinCapability[]
  enrollments                    Enrollment[]
  officialRosterImports          OfficialRosterImport[]
  rosterAlignmentRuns            RosterAlignmentRun[]
  rosterAlignmentPlatformEntries RosterAlignmentPlatformEntry[]
  rosterAlignmentResults         RosterAlignmentResult[]
  officialRosterEntries          OfficialRosterEntry[]
  exerciseSessions               ExerciseSession[]
  exerciseRecords                ExerciseRecord[]
  scoreRules                     ScoreRule[]
  studentScores                  StudentScore[]

  @@unique([id, organizationId], map: "class_sections_id_organization_id_key")
  @@unique([id, semesterId, organizationId], map: "class_sections_id_semester_organization_key")
  @@unique([id, courseId, semesterId, teacherId, organizationId], map: "class_sections_record_scope_key")
  @@unique([semesterId, courseId, classCode], map: "class_sections_semester_course_class_code_key")
  @@index([organizationId, teacherId, status, updatedAt, id], map: "class_sections_organization_teacher_status_updated_id_idx")
  @@index([organizationId, semesterId, courseId, status], map: "class_sections_organization_semester_course_status_idx")
  @@index([organizationId, status, updatedAt, id], map: "class_sections_organization_status_updated_id_idx")
  @@map("class_sections")
}

model ClassSectionExcludedDate {
  classSectionId String   @map("class_section_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  excludedDate   DateTime @map("excluded_date") @db.Date
  createdAt      DateTime @map("created_at") @db.Timestamptz(6)
  createdBy      String   @map("created_by") @db.Uuid

  classSection  ClassSection @relation(fields: [classSectionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdByUser User         @relation("ClassSectionExcludedDateCreatedBy", fields: [createdBy, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@id([classSectionId, excludedDate], map: "class_section_excluded_dates_pkey")
  @@index([organizationId, excludedDate], map: "class_section_excluded_dates_organization_date_idx")
  @@map("class_section_excluded_dates")
}

model CourseInvite {
  id                    String    @id @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  classSectionId        String    @map("class_section_id") @db.Uuid
  versionNumber         Int       @map("version_number")
  status                String    @db.VarChar(16)
  tokenHash             String    @unique(map: "course_invites_token_hash_key") @map("token_hash") @db.Char(64)
  secretCiphertext      String?   @map("secret_ciphertext") @db.Text
  secretKeyVersion      Int       @map("secret_key_version")
  secretReplayExpiresAt DateTime? @map("secret_replay_expires_at") @db.Timestamptz(6)
  createdBy             String    @map("created_by") @db.Uuid
  createdAt             DateTime  @map("created_at") @db.Timestamptz(6)
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy             String?   @map("revoked_by") @db.Uuid
  revokeReason          String?   @map("revoke_reason") @db.VarChar(1000)
  replacedByInviteId    String?   @map("replaced_by_invite_id") @db.Uuid
  rowVersion            Int       @default(1) @map("row_version")

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  classSection     ClassSection     @relation(fields: [classSectionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdByUser    User             @relation("CourseInviteCreatedBy", fields: [createdBy, organizationId], references: [id, organizationId], onDelete: Restrict)
  revokedByUser    User?            @relation("CourseInviteRevokedBy", fields: [revokedBy, organizationId], references: [id, organizationId], onDelete: Restrict)
  replacedByInvite CourseInvite?    @relation("CourseInviteReplacement", fields: [replacedByInviteId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "course_invites_replaced_by_organization_id_fkey")
